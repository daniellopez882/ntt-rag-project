# --- API ---------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8058
# Required by every route except /health. Callers send it as X-API-Key.
# Until it is set the API answers 503 (it fails closed). Any long random string.
API_KEY=
# Browser origins allowed to call the API, comma-separated. Empty = none.
CORS_ORIGINS=

# --- Streamlit UI ------------------------------------------------------------
SERVER_PORT=8501
API_URL=http://api:8058

# --- PostgreSQL + pgvector ---------------------------------------------------
DB_USER=postgres
DB_PASSWORD=
DB_HOST=postgres
DB_PORT=5432
DB_NAME=vector_db
# Or one URL instead of the parts:
# DATABASE_URL=postgresql://user:pass@host:5432/vector_db

# --- OpenAI --------------------------------------------------------------------
OPENAI_API_KEY=
LLM_CHOICE=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# --- Limits ---------------------------------------------------------------------
MAX_MESSAGE_CHARS=8000
MAX_CONTEXT_MESSAGES=10
SESSION_TIMEOUT_MINUTES=60
